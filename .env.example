# Copy this file to .env.local and add your key from https://aistudio.google.com/apikey
# Server-only: never prefix the key with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional private LiDAR pilot. Keep disabled until infrastructure is configured.
BODY_PILOT_ENABLED=false
BODY_PUBLIC_ORIGIN=http://localhost:3000
BODY_SESSION_SECRET=
# JSON array of {"userId":"participant-01","role":"user","codeHash":"SHA256_HEX"}
# Use a unique random invitation of at least 32 bytes per user; operator role is separate.
BODY_PILOT_INVITES=[]
BODY_DATABASE_URL=postgresql://form:CHANGE_ME@localhost:5432/form_body
BODY_POSTGRES_PASSWORD=
BODY_S3_BUCKET=form-body-private
BODY_S3_REGION=ca-central-1
BODY_S3_ENDPOINT=http://localhost:9000
BODY_S3_PATH_STYLE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# ElevenAgents (server only)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
