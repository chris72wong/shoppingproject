{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "productId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "category": {
      "type": "string",
      "enum": [
        "top",
        "bottom",
        "outerwear"
      ]
    },
    "identity": {
      "type": "object",
      "properties": {
        "brand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "sku": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "region": {
          "type": "string",
          "const": "US"
        },
        "variant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "productUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "brand",
        "sku",
        "region",
        "variant",
        "productUrl"
      ],
      "additionalProperties": false
    },
    "sources": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "product",
              "size-guide",
              "measurement-guide",
              "sample",
              "trial"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "url",
          "retrievedAt",
          "kind",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "measuredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "physicalSample": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "validated": {
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "measuredAt",
        "physicalSample",
        "validated"
      ],
      "additionalProperties": false
    },
    "pattern": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sourceKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "approvedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "dimensionToleranceM": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.01
        }
      },
      "required": [
        "version",
        "sourceKey",
        "approvedBy",
        "approvedAt",
        "dimensionToleranceM"
      ],
      "additionalProperties": false
    },
    "fabric": {
      "type": "object",
      "properties": {
        "calibrationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "composition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "enum": [
            "estimated",
            "sample-calibrated"
          ]
        },
        "recordKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "properties": {
          "type": "object",
          "properties": {
            "stretchWarp": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "stretchWeft": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "bending": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "densityKgM2": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "thicknessM": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 0.05
                },
                {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 0.05
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "friction": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 80
                },
                {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 80
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "stretchWarp",
            "stretchWeft",
            "bending",
            "densityKgM2",
            "thicknessM",
            "friction"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "calibrationId",
        "version",
        "composition",
        "status",
        "recordKey",
        "properties"
      ],
      "additionalProperties": false
    },
    "arrangementVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "requiredMeasurements": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "height",
          "chest",
          "waist",
          "hip",
          "shoulder",
          "inseam",
          "sleeve",
          "upperArm",
          "thigh",
          "rise"
        ]
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "estimated",
            "validated"
          ]
        },
        "reportKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "participants": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sizeAgreement": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "measurementGate": {
          "type": "boolean"
        },
        "appearanceGate": {
          "type": "boolean"
        },
        "subgroupReview": {
          "type": "boolean"
        },
        "sizes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          }
        },
        "bodyRanges": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "height",
              "chest",
              "waist",
              "hip",
              "shoulder",
              "inseam",
              "sleeve",
              "upperArm",
              "thigh",
              "rise"
            ]
          },
          "additionalProperties": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 3
              },
              {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 3
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "required": [
        "status",
        "participants",
        "sizeAgreement",
        "measurementGate",
        "appearanceGate",
        "subgroupReview",
        "sizes",
        "bodyRanges"
      ],
      "additionalProperties": false
    },
    "sizes": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "blendKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "ranges": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "height",
                "chest",
                "waist",
                "hip",
                "shoulder",
                "inseam",
                "sleeve",
                "upperArm",
                "thigh",
                "rise"
              ]
            },
            "additionalProperties": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 3
                },
                {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 3
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "bodyChart": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "height",
                "chest",
                "waist",
                "hip",
                "shoulder",
                "inseam",
                "sleeve",
                "upperArm",
                "thigh",
                "rise"
              ]
            },
            "additionalProperties": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 3
                },
                {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 3
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "preferredEase": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "height",
                "chest",
                "waist",
                "hip",
                "shoulder",
                "inseam",
                "sleeve",
                "upperArm",
                "thigh",
                "rise"
              ]
            },
            "additionalProperties": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": -0.5,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": -0.5,
                  "maximum": 1
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "dimensions": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 3000
                },
                "uncertainty": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 300
                },
                "units": {
                  "type": "string",
                  "enum": [
                    "m",
                    "cm",
                    "mm",
                    "in"
                  ]
                },
                "convention": {
                  "type": "string",
                  "enum": [
                    "length",
                    "circumference",
                    "flat-width"
                  ]
                },
                "origin": {
                  "type": "string",
                  "enum": [
                    "published",
                    "measured",
                    "estimated"
                  ]
                },
                "sourceIndex": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "method": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "required": [
                "value",
                "uncertainty",
                "units",
                "convention",
                "origin",
                "sourceIndex",
                "method"
              ],
              "additionalProperties": false
            }
          },
          "sampleId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "label",
          "blendKey",
          "ranges",
          "bodyChart",
          "preferredEase",
          "dimensions"
        ],
        "additionalProperties": false
      }
